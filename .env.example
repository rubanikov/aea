# ---------------------------------------------------------------------------
# Backend (Django, backend/) — placeholder values only. Copy this file to
# .env at the repo root and fill in real values for local dev; never commit
# the real .env.
# ---------------------------------------------------------------------------

# Postgres connection string. Supabase and Railway both hand out this exact
# format (postgresql://user:password@host:port/dbname). Defaults to a local
# Postgres instance (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`)
# if unset, so local dev works without a live Supabase project.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Django's cryptographic signing key. Generate a real one for anything beyond
# local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme-insecure-dev-only-key

# "True" enables Django's debug error pages (local dev only — never on a
# deployed/shared environment, since they can leak internals). Defaults to
# False if unset.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve. Defaults to
# "localhost,127.0.0.1" if unset; add the Railway domain in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to make cross-origin requests to
# this API (django-cors-headers) — the Next.js frontend's own origin, not
# the API's. Defaults to "http://localhost:3000" if unset; add the deployed
# Vercel URL in production. Must be an exact origin (scheme + host + port),
# no trailing slash, no path.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Signing key for the auth JWTs (djangorestframework-simplejwt). Optional —
# falls back to DJANGO_SECRET_KEY if unset. Set a separate value in any
# shared/deployed environment so rotating one secret doesn't invalidate the
# other's guarantees. Generate the same way as DJANGO_SECRET_KEY.
JWT_SECRET_KEY=

# Resend API key (reminders/ app, TICKET-12) — used by the
# `dispatch_reminders` management command (Railway cron) to send the 24h
# appointment reminder email. Get a real one from https://resend.com if
# testing an actual send. Left unset here on purpose: with no key,
# reminders.emails.send_reminder_email logs a warning and skips the send
# instead of sending or erroring — safe default for local/CI/demo
# environments that never have a real key (see reminders/README.md).
RESEND_API_KEY=

# The "from" address Resend sends reminder emails as. Must be a domain
# verified in your Resend account for a real send to succeed; the
# placeholder below only matters once RESEND_API_KEY is actually set.
RESEND_FROM_EMAIL=reminders@example.com

# Base URL of the deployed frontend (Vercel) — embedded as the "view
# details" link in the reminder email body. Distinct from
# CORS_ALLOWED_ORIGINS above: that's what origins may call this API, this
# is what link a third-party email (Resend) should point at. Defaults to
# the local Next.js dev server if unset.
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Next.js, frontend/) — placeholder values only. Copy this file to
# .env.local inside frontend/ for local dev; never commit the real file.
# ---------------------------------------------------------------------------

# Base URL of the backend API the frontend calls. Points at the local Django
# dev server by default; set to the deployed Railway URL in Vercel's env
# config for preview/production.
NEXT_PUBLIC_API_URL=http://localhost:8000
