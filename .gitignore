# Env files (never commit secrets — see .env.example)
.env
.env.local
*.env.local

# Local-only credential notes (e.g. the rotated deployed-admin password)
*.local.md

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local tooling state (not part of the project)
.claude/

# Local downloaded tools (e.g. portable k6)
.tools/

# Python (backend/) — see backend/.gitignore for the full set
__pycache__/
*.pyc
.venv/

# Node (frontend/) — see frontend/.gitignore, if present, for the full set
node_modules/
.next/
